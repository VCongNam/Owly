meta {
  name: Create Grade Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/classes/:classId/grade-categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

params:path {
  classId: CLASS_UUID
}

body:json {
  {
    "name": "Kiểm tra 15 phút",
    "weight": 0.15
  }
}
