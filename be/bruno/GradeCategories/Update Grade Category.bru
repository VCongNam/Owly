meta {
  name: Update Grade Category
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/classes/:classId/grade-categories/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

params:path {
  classId: CLASS_UUID
  id: CATEGORY_UUID
}

body:json {
  {
    "name": "Kiểm tra 15 phút (Cập nhật)",
    "weight": 0.20
  }
}
